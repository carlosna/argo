{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "service", "rollout", "istio", "analysis"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 2
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "rollout": {
      "type": "object",
      "required": ["steps", "maxSurge", "maxUnavailable"],
      "properties": {
        "steps": { "type": "array", "minItems": 1 }
      }
    },
    "istio": {
      "type": "object",
      "required": ["enabled", "gateway", "virtualService"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": {
          "type": "object",
          "required": ["name", "hosts"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "hosts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["enabled", "prometheusAddress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "prometheusAddress": {
          "type": "string",
          "pattern": "^https?://"
        },
        "successRateThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}

